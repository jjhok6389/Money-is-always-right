FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CREDENTIALS_PATH=./serviceAccountKey.json
# Render 배포 시 JSON 전체를 한 줄로 넣기 (파일 경로 대신)
FIREBASE_CREDENTIALS_JSON=
ALLOW_DEMO_MODE=true
# 배포 프론트 origin (쉼표 구분). Vercel *.vercel.app 은 코드에서 regex로도 허용
CORS_ORIGINS=https://your-app.vercel.app

# 금융감독원 금융상품한눈에 Open API 인증키
# https://finlife.fss.or.kr/finlife/main/contents.do?menuNo=700029
FSS_API_KEY=
FSS_BASE_URL=https://finlife.fss.or.kr/finlifeapi
FSS_TOP_FIN_GRP_NO=020000

# AWS Bedrock (AI 금융 코치)
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_MAX_TOKENS=1024
BEDROCK_FALLBACK_ENABLED=true
BEDROCK_KNOWLEDGE_BASE_ID=
# Managed/classic KB data source ID (콘솔 Data source 또는 list-data-sources)
BEDROCK_KB_DATA_SOURCE_ID=

# ETF 일배치: KRX → Firestore → kb/etf → S3 → Bedrock ingest
# 버킷/데이터소스 비우면 해당 단계만 skip
ETF_S3_BUCKET=
ETF_S3_PREFIX=kb/etf/
ETF_S3_SYNC_DELETE=true
ETF_SYNC_SCHEDULER_ENABLED=true
ETF_SYNC_HOUR_KST=18
ETF_SYNC_MINUTE_KST=0

# 지식 검색(RAG) — scripts/build_knowledge_index.py 로 인덱스 생성
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSIONS=1024
# 비워두면 backend/data/knowledge_index.json 사용
KNOWLEDGE_INDEX_PATH=
KNOWLEDGE_TOP_K=3
# 검색 신뢰도 라벨 기준 (차단선 아님). eval_knowledge.py 로 재측정 후 조정
KNOWLEDGE_MIN_VECTOR_SCORE=0.33
KNOWLEDGE_MIN_KEYWORD_SCORE=0.31

# KRX Open API (ETF 일별매매정보) — Spec.docx 기준
# POST https://data-dbg.krx.co.kr/svc/apis/etp/etf_bydd_trd
# Header AUTH_KEY, Body {"basDd":"YYYYMMDD"}
# 인증키 발급만으로는 401. 서비스 이용 → 증권상품 → ‘ETF 일별매매정보’ 이용신청·승인 필요.
KRX_AUTH_KEY=
KRX_BASE_URL=https://data-dbg.krx.co.kr/svc/apis
