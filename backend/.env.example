FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CREDENTIALS_PATH=./serviceAccountKey.json
ALLOW_DEMO_MODE=true

# 금융감독원 금융상품한눈에 Open API 인증키
# https://finlife.fss.or.kr/finlife/main/contents.do?menuNo=700029
FSS_API_KEY=
FSS_BASE_URL=https://finlife.fss.or.kr/finlifeapi
FSS_TOP_FIN_GRP_NO=020000

# AWS Bedrock (AI 금융 코치)
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_MAX_TOKENS=1024
BEDROCK_FALLBACK_ENABLED=true

# KRX Open API (ETF 일별매매정보)
# https://openapi.krx.co.kr/contents/OPP/USES/service/OPPUSES003_S2.cmd?BO_ID=nrEpCLaZpoLCTzPUMxuF
# Header AUTH_KEY 로 전달. 비어 있으면 mock ETF 시계열 사용.
KRX_AUTH_KEY=
KRX_BASE_URL=https://data-dbg.krx.co.kr/svc/apis
