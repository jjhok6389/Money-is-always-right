FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CREDENTIALS_PATH=./serviceAccountKey.json
ALLOW_DEMO_MODE=true

# 금융감독원 금융상품한눈에 Open API 인증키
# https://finlife.fss.or.kr/finlife/main/contents.do?menuNo=700029
FSS_API_KEY=
FSS_BASE_URL=https://finlife.fss.or.kr/finlifeapi
FSS_TOP_FIN_GRP_NO=020000

# AWS Bedrock (AI 금융 코치)
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_MAX_TOKENS=1024
BEDROCK_FALLBACK_ENABLED=true

# 지식 검색(RAG) — scripts/build_knowledge_index.py 로 인덱스 생성
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSIONS=1024
# 비워두면 backend/data/knowledge_index.json 사용
KNOWLEDGE_INDEX_PATH=
KNOWLEDGE_TOP_K=3
# 검색 신뢰도 라벨 기준 (차단선 아님). eval_knowledge.py 로 재측정 후 조정
KNOWLEDGE_MIN_VECTOR_SCORE=0.33
KNOWLEDGE_MIN_KEYWORD_SCORE=0.31
